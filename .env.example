# Image build pins. Defaults live in the ARG lines of Dockerfile.openclaw; uncomment a pin
# only to override it. Keep the version and digest paired when updating a release.
# OPENCLAW_VERSION=2026.11.2
# OPENCLAW_SHA256=sha256:7881887b88d81e5fdff361b7aac59b6a736308e1815a175b9ccd9cdca1bb5e48
# DEBIAN_SNAPSHOT=20261027T000000Z
# GOGCLI_VERSION=0.47.1
# GOGCLI_AMD64_SHA256=sha256:279bc3a03c1919d774e268ef229949f45b753a0e21257f9fb315b05be7a40ea9
# GOGCLI_ARM64_SHA256=sha256:c677ac6abf5e187e987a87fe1b588f454b002a7d7019de81b9e8db02e9e902b6
# OFFICECLI_VERSION=v1.0.160
# OFFICECLI_ARM64_SHA256=e8f06aff6c59f11a73a1a1218bda3ce170299201fd56bce6d62ecd4d0c024e53
# OFFICECLI_AMD64_SHA256=baa084b64ec634bd9d41a0592db3ed85f11658b358bab898679537ea7f3e73a9
# OFFICECLI_SKILL_SHA256=c950d285ce60021712b4753fb2d9f592308d5622bab776229061dfecb1ce55d4

# Local build tag (default openclaw:local) and target (default linux/arm64).
# MARACLAW_OPENCLAW_IMAGE=openclaw:2026.11.2
# DOCKER_PLATFORM=linux/arm64

# Auxiliary downloads default to online; staged mode reads the named asset layout.
# OPENCLAW_ASSET_MODE=staged
# OPENCLAW_ASSET_DIR="/absolute/path/to/staged assets"
# Optional Humanizer archive pins; omitted values use installer defaults.
# HUMANIZER_COMMIT=
# HUMANIZER_SHA256=

# Publication: Docker Hub namespace or full repository; docker login required.
# DOCKERHUB_NAMESPACE=youruser
# OPENCLAW_PUBLISH_IMAGE=youruser/openclaw
# IMAGE_TAG=2026.11.2
# PUSH_LATEST=0
