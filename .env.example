# Image build pins. Defaults live in the ARG lines of Dockerfile.openclaw; uncomment a pin
# only to override it. Keep the version and digest paired when updating a release.
# OPENCLAW_VERSION=2026.11.5
# OPENCLAW_SHA256=sha256:a57d1272b7d87bdbf2b0a0e18811dc1ca3ffc5de02229d1f9e2884bd38470794
# DEBIAN_SNAPSHOT=20261108T214731Z
# GOGCLI_VERSION=0.48.1
# GOGCLI_AMD64_SHA256=sha256:dcd956e09d1222a07c1304d836f8acd55266b2fa241ef466580ced6a02453d72
# GOGCLI_ARM64_SHA256=sha256:c091fa2014dc3d5608acef4d09fb3bb4a3eb71e4cff898b5eaddd9703599e45c
# OFFICECLI_VERSION=v1.0.162
# OFFICECLI_ARM64_SHA256=59763bc3e9f03784fb4ddb7a2571deabaaf5fb999f42aaee6407191424c38816
# OFFICECLI_AMD64_SHA256=df40e8f21b5c84826565f7c9c96f7e1a70ffbfe141b507bdad70533eaeacc190
# OFFICECLI_SKILL_SHA256=c950d285ce60021712b4753fb2d9f592308d5622bab776229061dfecb1ce55d4

# Local build tag (default openclaw:local) and target (default linux/arm64).
# MARACLAW_OPENCLAW_IMAGE=openclaw:2026.11.5
# DOCKER_PLATFORM=linux/arm64

# Auxiliary downloads default to online; staged mode reads the named asset layout.
# OPENCLAW_ASSET_MODE=staged
# OPENCLAW_ASSET_DIR="/absolute/path/to/staged assets"
# Optional Humanizer archive pins; omitted values use installer defaults.
# HUMANIZER_COMMIT=
# HUMANIZER_SHA256=
# Optional TraceLattice skill archive pins; omitted values use installer defaults.
# TRACELATTICE_SKILL_COMMIT=
# TRACELATTICE_SKILL_SHA256=
# TraceLattice npm package pins (defaults in Dockerfile.openclaw); keep version and digest paired.
# TRACELATTICE_VERSION=2.4.6
# TRACELATTICE_SHA256=sha256:ca5d64c85a18f0eaeca07b18f5f5faa3501d541f8e001b4011b28e5cc6cc0511

# Optional BuildKit cache for both scripts; unset or empty passes no cache flag.
# Exporting needs a builder whose driver supports it (the default docker driver may not).
# OPENCLAW_BUILD_CACHE_FROM=type=local,src=/absolute/path/to/buildkit-cache
# OPENCLAW_BUILD_CACHE_TO=type=local,dest=/absolute/path/to/buildkit-cache,mode=max

# Publication: Docker Hub namespace or full repository; docker login required.
# DOCKERHUB_NAMESPACE=youruser
# OPENCLAW_PUBLISH_IMAGE=youruser/openclaw
# IMAGE_TAG=2026.11.5
# PUSH_LATEST=0
# OPENCLAW_BUILD_METADATA_FILE="/absolute/path/to/openclaw-build-metadata.json"
