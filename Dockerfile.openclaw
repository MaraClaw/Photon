ARG OPENCLAW_BASE_IMAGE_AMD64=nikolaik/python-nodejs@sha256:0081cd01c832e6db2ddb040a3dd4c7d282c4068c57a39280c6a40b2853ec000e
ARG OPENCLAW_BASE_IMAGE_ARM64=nikolaik/python-nodejs@sha256:0d79217e1afd8ec1657305749dc3eb187963ab7934e35f89ac40c5bb4a165f07
FROM ${OPENCLAW_BASE_IMAGE_AMD64} AS base_amd64
FROM ${OPENCLAW_BASE_IMAGE_ARM64} AS base_arm64
FROM base_${TARGETARCH}
SHELL ["/bin/sh", "-c"]

ARG TARGETOS
ARG TARGETARCH
ARG OPENCLAW_VERSION=2026.10.8
ARG OPENCLAW_SHA256=sha256:7e36685a0b5fd9c8c3afcfa93ee33fad871f7c6c8b6e695cae6720d14a765f18
ARG TINI_VERSION=0.19.0-3+b8
ARG CA_CERTIFICATES_VERSION=20250419+deb13u1
ARG CURL_VERSION=8.14.1-2+deb13u7
ARG LIBCURL4_VERSION=8.14.1-2+deb13u7
ARG BASH_VERSION=5.2.37-2+b10
ARG LIBICU76_VERSION=76.1-4
ARG GOGCLI_VERSION=0.47.1
ARG GOGCLI_AMD64_SHA256=sha256:279bc3a03c1919d774e268ef229949f45b753a0e21257f9fb315b05be7a40ea9
ARG GOGCLI_ARM64_SHA256=sha256:c677ac6abf5e187e987a87fe1b588f454b002a7d7019de81b9e8db02e9e902b6

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    "bash=${BASH_VERSION}" \
    "ca-certificates=${CA_CERTIFICATES_VERSION}" \
    "curl=${CURL_VERSION}" \
    "libcurl4t64=${LIBCURL4_VERSION}" \
    "libicu76=${LIBICU76_VERSION}" \
    "tini=${TINI_VERSION}" \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g npm@12.2.1 \
    && npm pack "openclaw@${OPENCLAW_VERSION}" --pack-destination /tmp \
    && OPENCLAW_TARBALL="/tmp/openclaw-${OPENCLAW_VERSION}.tgz" \
    && test -f "$OPENCLAW_TARBALL" \
    && printf '%s  %s\n' "${OPENCLAW_SHA256#sha256:}" "$OPENCLAW_TARBALL" > /tmp/openclaw.tgz.sha256 \
    && sha256sum -c /tmp/openclaw.tgz.sha256 \
    && npm install -g --allow-scripts="$OPENCLAW_TARBALL" "$OPENCLAW_TARBALL" \
    && rm -f "$OPENCLAW_TARBALL" /tmp/openclaw.tgz.sha256 \
    && rm -rf /root/.npm

RUN groupmod -n node pn \
    && usermod -l node -d /home/node -m pn

RUN case "$TARGETOS/$TARGETARCH" in \
        linux/amd64) GOGCLI_SHA256="$GOGCLI_AMD64_SHA256" ;; \
        linux/arm64) GOGCLI_SHA256="$GOGCLI_ARM64_SHA256" ;; \
        *) printf 'unsupported guest target: %s/%s\n' "$TARGETOS" "$TARGETARCH" >&2; exit 2 ;; \
    esac \
    && curl -fsSL \
    "https://github.com/openclaw/gogcli/releases/download/v${GOGCLI_VERSION}/gogcli_${GOGCLI_VERSION}_${TARGETOS}_${TARGETARCH}.tar.gz" \
    -o /tmp/gogcli.tar.gz \
    && printf '%s  %s\n' "${GOGCLI_SHA256#sha256:}" /tmp/gogcli.tar.gz > /tmp/gogcli.tar.gz.sha256 \
    && sha256sum -c /tmp/gogcli.tar.gz.sha256 \
    && tar -xzf /tmp/gogcli.tar.gz -C /usr/local/bin ./gog \
    && chmod 0755 /usr/local/bin/gog \
    && rm -f /tmp/gogcli.tar.gz /tmp/gogcli.tar.gz.sha256 \
    && gog --version

ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    OFFICECLI_SKIP_UPDATE=1 \
    OFFICECLI_NO_AUTO_RESIDENT=1

COPY docker/openclaw/install-officecli.sh /tmp/install-officecli.sh
RUN sh /tmp/install-officecli.sh && rm /tmp/install-officecli.sh
COPY docker/openclaw/install-gogcli-skills.sh /tmp/install-gogcli-skills.sh
RUN sh /tmp/install-gogcli-skills.sh && rm /tmp/install-gogcli-skills.sh
COPY docker/openclaw/install-soul-guardian.sh /tmp/install-soul-guardian.sh
RUN sh /tmp/install-soul-guardian.sh && rm /tmp/install-soul-guardian.sh
COPY docker/openclaw/linkup-skills/ /tmp/linkup-skills/
COPY docker/openclaw/install-linkup.sh /tmp/install-linkup.sh
RUN sh /tmp/install-linkup.sh && rm /tmp/install-linkup.sh
COPY docker/openclaw/validate-gogcli.sh /usr/local/bin/validate-gogcli.sh
RUN chmod 0755 /usr/local/bin/validate-gogcli.sh
COPY docker/openclaw/validate-officecli.sh /usr/local/bin/validate-officecli.sh
COPY docker/openclaw/validate-soul-guardian.sh /usr/local/bin/validate-soul-guardian.sh
COPY docker/openclaw/validate-linkup.sh /usr/local/bin/validate-linkup.sh
COPY docker/openclaw/startup-probe.sh /usr/local/bin/startup-probe.sh
COPY docker/openclaw/startup-probe.py /usr/local/bin/startup-probe.py
RUN chmod 0755 /usr/local/bin/validate-officecli.sh /usr/local/bin/validate-soul-guardian.sh /usr/local/bin/validate-linkup.sh /usr/local/bin/startup-probe.sh /usr/local/bin/startup-probe.py

USER node
ENTRYPOINT ["tini", "-s", "--", "/usr/local/bin/validate-gogcli.sh", "/usr/local/bin/validate-officecli.sh", "/usr/local/bin/validate-soul-guardian.sh", "/usr/local/bin/validate-linkup.sh"]
CMD ["openclaw", "gateway"]
