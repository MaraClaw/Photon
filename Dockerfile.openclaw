ARG OPENCLAW_BASE_IMAGE_AMD64=nikolaik/python-nodejs:python3.15-nodejs26-slim@sha256:9b336a6647435ad6cb01107c1564e50eb867aebb14d0ca1dc04776f899b27e44
ARG OPENCLAW_BASE_IMAGE_ARM64=nikolaik/python-nodejs:python3.15-nodejs26-slim@sha256:552fd665f95f93fbbba5d145807667ddbf3b62fd45d555541b62eed7310cfe19
FROM scratch AS openclaw_assets
FROM ${OPENCLAW_BASE_IMAGE_AMD64} AS base_amd64
FROM ${OPENCLAW_BASE_IMAGE_ARM64} AS base_arm64
FROM base_${TARGETARCH}
SHELL ["/bin/sh", "-c"]

ARG TARGETOS
ARG TARGETARCH
ARG OPENCLAW_ASSET_MODE=online
ARG OPENCLAW_VERSION=2026.11.1
ARG OPENCLAW_SHA256=sha256:611282534d576e12f10b0ac5a1ac0d2825aac360637e92815a56eb71fb5a0301
ARG DEBIAN_SNAPSHOT=20261027T000000Z
ARG TINI_VERSION=0.19.0-3+b8
ARG CA_CERTIFICATES_VERSION=20250419+deb13u1
ARG CURL_VERSION=8.14.1-2+deb13u7
ARG LIBCURL4_VERSION=8.14.1-2+deb13u7
ARG BASH_VERSION=5.2.37-2+b10
ARG LIBICU76_VERSION=76.1-4
ARG GOGCLI_VERSION=0.47.1
ARG GOGCLI_AMD64_SHA256=sha256:279bc3a03c1919d774e268ef229949f45b753a0e21257f9fb315b05be7a40ea9
ARG GOGCLI_ARM64_SHA256=sha256:c677ac6abf5e187e987a87fe1b588f454b002a7d7019de81b9e8db02e9e902b6
ARG OFFICECLI_VERSION=v1.0.160
ARG OFFICECLI_ARM64_SHA256=e8f06aff6c59f11a73a1a1218bda3ce170299201fd56bce6d62ecd4d0c024e53
ARG OFFICECLI_AMD64_SHA256=baa084b64ec634bd9d41a0592db3ed85f11658b358bab898679537ea7f3e73a9
ARG OFFICECLI_SKILL_SHA256=c950d285ce60021712b4753fb2d9f592308d5622bab776229061dfecb1ce55d4
ARG GOGCLI_SKILLS_COMMIT
ARG GOGCLI_SKILLS_SHA256
ARG CLAWSEC_COMMIT
ARG CLAWSEC_SHA256
ARG HUMANIZER_COMMIT
ARG HUMANIZER_SHA256

USER root
RUN --mount=type=bind,source=docker/openclaw/openclaw-package,target=/tmp/openclaw-package \
    sed -i \
        -e "s#http://deb.debian.org/debian-security#https://snapshot.debian.org/archive/debian-security/${DEBIAN_SNAPSHOT}#" \
        -e "s#http://deb.debian.org/debian#https://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT}#" \
        -e '/^URIs:/a Check-Valid-Until: no' \
        /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Retries=3 update \
    && apt-get -o Acquire::Retries=3 install -y --no-install-recommends \
    "bash=${BASH_VERSION}" \
    "ca-certificates=${CA_CERTIFICATES_VERSION}" \
    "curl=${CURL_VERSION}" \
    "libcurl4t64=${LIBCURL4_VERSION}" \
    "libicu76=${LIBICU76_VERSION}" \
    "tini=${TINI_VERSION}" \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g npm@12.2.1 \
    && install -D -m 0644 -t /opt/openclaw /tmp/openclaw-package/package.json /tmp/openclaw-package/package-lock.json \
    && LOCKED_VERSION=$(node -p 'require("/opt/openclaw/package-lock.json").packages["node_modules/openclaw"].version') \
    && if [ "$LOCKED_VERSION" != "$OPENCLAW_VERSION" ]; then printf 'OPENCLAW_VERSION=%s does not match the openclaw version %s locked in docker/openclaw/openclaw-package/package-lock.json\n' "$OPENCLAW_VERSION" "$LOCKED_VERSION" >&2; exit 1; fi \
    && npm pack "openclaw@${OPENCLAW_VERSION}" --pack-destination /tmp \
    && OPENCLAW_TARBALL="/tmp/openclaw-${OPENCLAW_VERSION}.tgz" \
    && test -f "$OPENCLAW_TARBALL" \
    && printf '%s  %s\n' "${OPENCLAW_SHA256#sha256:}" "$OPENCLAW_TARBALL" > /tmp/openclaw.tgz.sha256 \
    && sha256sum -c /tmp/openclaw.tgz.sha256 \
    && LOCKED_SHA512=$(node -p 'Buffer.from(require("/opt/openclaw/package-lock.json").packages["node_modules/openclaw"].integrity.slice(7), "base64").toString("hex")') \
    && printf '%s  %s\n' "$LOCKED_SHA512" "$OPENCLAW_TARBALL" > /tmp/openclaw.lock.sha512 \
    && sha512sum -c /tmp/openclaw.lock.sha512 \
    && npm ci --prefix /opt/openclaw --install-strategy=shallow --omit=dev --no-audit --no-fund \
    && ln -s /opt/openclaw/node_modules/.bin/openclaw /usr/local/bin/openclaw \
    && rm -f "$OPENCLAW_TARBALL" /tmp/openclaw.tgz.sha256 /tmp/openclaw.lock.sha512 \
    && rm -rf /root/.npm

RUN groupmod -n node pn \
    && usermod -l node -d /home/node -m pn

ENV HOME=/home/node
RUN install -d -o node -g node -m 0755 "$HOME/.openclaw"

RUN --mount=type=bind,from=openclaw_assets,target=/staged case "$TARGETOS/$TARGETARCH" in \
        linux/amd64) GOGCLI_SHA256="$GOGCLI_AMD64_SHA256" ;; \
        linux/arm64) GOGCLI_SHA256="$GOGCLI_ARM64_SHA256" ;; \
        *) printf 'unsupported guest target: %s/%s\n' "$TARGETOS" "$TARGETARCH" >&2; exit 2 ;; \
    esac \
    && case "$OPENCLAW_ASSET_MODE" in \
        online) curl --disable --config /dev/null --fail --silent --show-error --location --proto '=https' --proto-redir '=https' \
            --connect-timeout 15 --max-time 120 --retry 2 --retry-delay 1 --retry-max-time 60 --noproxy '*' \
            "https://github.com/openclaw/gogcli/releases/download/v${GOGCLI_VERSION}/gogcli_${GOGCLI_VERSION}_${TARGETOS}_${TARGETARCH}.tar.gz" \
            -o /tmp/gogcli.tar.gz && GOGCLI_ARCHIVE=/tmp/gogcli.tar.gz ;; \
        staged) GOGCLI_ARCHIVE="/staged/linux-${TARGETARCH}/gogcli.tar.gz" ;; \
        *) printf 'unsupported OPENCLAW_ASSET_MODE: %s\n' "$OPENCLAW_ASSET_MODE" >&2; exit 2 ;; \
    esac \
    && printf '%s  %s\n' "${GOGCLI_SHA256#sha256:}" "$GOGCLI_ARCHIVE" > /tmp/gogcli.tar.gz.sha256 \
    && sha256sum -c /tmp/gogcli.tar.gz.sha256 \
    && tar -xzf "$GOGCLI_ARCHIVE" -C /usr/local/bin ./gog \
    && chmod 0755 /usr/local/bin/gog \
    && rm -f /tmp/gogcli.tar.gz /tmp/gogcli.tar.gz.sha256 \
    && gog --version

ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    OFFICECLI_SKIP_UPDATE=1 \
    OFFICECLI_NO_AUTO_RESIDENT=1

COPY docker/openclaw/install-common.sh /tmp/install-common.sh
COPY docker/openclaw/install-officecli.sh /tmp/install-officecli.sh
RUN --mount=type=bind,from=openclaw_assets,target=/staged \
    case "$OPENCLAW_ASSET_MODE" in \
        online) sh /tmp/install-officecli.sh ;; \
        staged) sh /tmp/install-officecli.sh --binary-file "/staged/linux-${TARGETARCH}/officecli" --skill-file /staged/common/officecli-SKILL.md ;; \
        *) exit 2 ;; \
    esac && rm /tmp/install-officecli.sh
COPY docker/openclaw/install-gogcli-skills.sh /tmp/install-gogcli-skills.sh
RUN --mount=type=bind,from=openclaw_assets,target=/staged \
    install -d -m 0755 /usr/local/share/openclaw-integrity \
    && case "$OPENCLAW_ASSET_MODE" in \
        online) sh /tmp/install-gogcli-skills.sh --ownership-output /usr/local/share/openclaw-integrity/gog-skill-roots.txt ;; \
        staged) sh /tmp/install-gogcli-skills.sh --archive-file /staged/common/gogcli-skills.tar.gz --ownership-output /usr/local/share/openclaw-integrity/gog-skill-roots.txt ;; \
        *) exit 2 ;; \
    esac && rm /tmp/install-gogcli-skills.sh
COPY docker/openclaw/install-soul-guardian.sh /tmp/install-soul-guardian.sh
RUN --mount=type=bind,from=openclaw_assets,target=/staged \
    case "$OPENCLAW_ASSET_MODE" in \
        online) sh /tmp/install-soul-guardian.sh ;; \
        staged) sh /tmp/install-soul-guardian.sh --archive-file /staged/common/soul-guardian.tar.gz ;; \
        *) exit 2 ;; \
    esac && rm /tmp/install-soul-guardian.sh
COPY docker/openclaw/install-humanizer.sh /tmp/install-humanizer.sh
RUN --mount=type=bind,from=openclaw_assets,target=/staged \
    case "$OPENCLAW_ASSET_MODE" in \
        online) sh /tmp/install-humanizer.sh ;; \
        staged) sh /tmp/install-humanizer.sh --archive-file /staged/common/humanizer.tar.gz ;; \
        *) exit 2 ;; \
    esac && rm /tmp/install-humanizer.sh
COPY docker/openclaw/humanizer-soul.md /tmp/humanizer-soul.md
COPY docker/openclaw/officecli-soul.md /tmp/officecli-soul.md
COPY docker/openclaw/soul-guardian-soul.md /tmp/soul-guardian-soul.md
COPY docker/openclaw/tavily-soul.md /tmp/tavily-soul.md
RUN template="/opt/openclaw/node_modules/openclaw/docs/reference/templates/SOUL.md" \
    && test -s "$template" \
    && install -d -m 0755 /usr/local/share/openclaw \
    && cat /tmp/humanizer-soul.md /tmp/officecli-soul.md /tmp/soul-guardian-soul.md /tmp/tavily-soul.md > /usr/local/share/openclaw/skills-soul.md \
    && chmod 0644 /usr/local/share/openclaw/skills-soul.md \
    && cat /usr/local/share/openclaw/skills-soul.md >> "$template" \
    && rm /tmp/humanizer-soul.md /tmp/officecli-soul.md /tmp/soul-guardian-soul.md /tmp/tavily-soul.md
COPY docker/openclaw/tavily-skills/ /tmp/tavily-skills/
COPY docker/openclaw/install-tavily.sh /tmp/install-tavily.sh
RUN sh /tmp/install-tavily.sh && rm /tmp/install-tavily.sh /tmp/install-common.sh
COPY docker/openclaw/check-skills.py /tmp/check-skills.py
RUN python3 /tmp/check-skills.py --skills-root "$HOME/.openclaw/skills" && rm /tmp/check-skills.py
COPY docker/openclaw/installed-assets.py /usr/local/bin/installed-assets.py
RUN python3 /usr/local/bin/installed-assets.py create \
    --skills-root "$HOME/.openclaw/skills" \
    --gog-roots-file /usr/local/share/openclaw-integrity/gog-skill-roots.txt \
    --output-dir /usr/local/share/openclaw-integrity
COPY --chmod=0755 docker/openclaw/validate-gogcli.sh /usr/local/bin/validate-gogcli.sh
COPY --chmod=0755 docker/openclaw/validate-officecli.sh /usr/local/bin/validate-officecli.sh
COPY --chmod=0755 docker/openclaw/validate-soul-guardian.sh /usr/local/bin/validate-soul-guardian.sh
COPY --chmod=0755 docker/openclaw/validate-tavily.sh /usr/local/bin/validate-tavily.sh
COPY --chmod=0755 docker/openclaw/validate-humanizer.sh /usr/local/bin/validate-humanizer.sh
COPY --chmod=0755 docker/openclaw/startup-probe.sh /usr/local/bin/startup-probe.sh
COPY --chmod=0755 docker/openclaw/startup-probe.py /usr/local/bin/startup-probe.py
COPY --chmod=0755 docker/openclaw/bootstrap_event.py /usr/local/bin/bootstrap_event.py
COPY --chmod=0755 docker/openclaw/bootstrap-agent-container.py /usr/local/bin/bootstrap-agent-container.py

USER node
ENTRYPOINT ["tini", "-s", "--", "/usr/local/bin/validate-gogcli.sh", "/usr/local/bin/validate-officecli.sh", "/usr/local/bin/validate-soul-guardian.sh", "/usr/local/bin/validate-tavily.sh", "/usr/local/bin/validate-humanizer.sh", "/usr/local/bin/bootstrap-agent-container.py"]
CMD ["openclaw", "gateway"]
